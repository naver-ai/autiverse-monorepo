{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/backend",
  "targets": {
    "lock": {
      "executor": "@nxlv/python:lock",
      "options": {
        "update": false
      }
    },
    "sync": {
      "executor": "@nxlv/python:sync",
      "options": {}
    },
    "add": {
      "executor": "@nxlv/python:add",
      "options": {}
    },
    "update": {
      "executor": "@nxlv/python:update",
      "options": {}
    },
    "remove": {
      "executor": "@nxlv/python:remove",
      "options": {}
    },
    "build": {
      "executor": "@nxlv/python:build",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "publish": false,
        "lockedVersions": true,
        "bundleLocalDependencies": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nxlv/python:flake8",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/pylint.txt"
      ],
      "options": {
        "outputFile": "reports/{projectRoot}/pylint.txt"
      },
      "cache": true
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "outputs": [
        "{workspaceRoot}/reports/{projectRoot}/unittests",
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "command": "poetry run pytest tests/",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "install": {
      "executor": "@nxlv/python:install",
      "options": {
        "silent": false,
        "args": "",
        "cacheDir": ".cache/pypoetry",
        "verbose": false,
        "debug": false
      }
    },

    "run-dev": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/run-dev.py",
        "cwd": "{projectRoot}"
      }
    },

    "reset-db": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/reset-db.py",
        "cwd": "{projectRoot}"
      }
    },

    "stop-prod": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/kill_production_server.py",
        "cwd": "{projectRoot}"
      }
    },

    "status-prod": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/kill_production_server.py --status",
        "cwd": "{projectRoot}"
      }
    },

    "test_langchain": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/test_langchain.py",
        "cwd": "{projectRoot}"
      }
    },

    "comic_intro": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/comic_intro.py",
        "cwd": "{projectRoot}"
      }
    },

    "comic_context": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/comic_context.py",
        "cwd": "{projectRoot}"
      }
    },

    "revision_1": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/revision_1.py",
        "cwd": "{projectRoot}"
      }
    },

    "revision_2": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "poetry run python backend/revision_2.py",
        "cwd": "{projectRoot}"
      }
    }

  },
  "tags": [],
  "release": {
    "version": {
      "generator": "@nxlv/python:release-version"
    }
  }
}